# ==============================================================================
# CausalOps — Environment Configuration Template
# Phase 7: Production Hardening
# ==============================================================================
# Copy this file to .env and populate real values for local development.
# DO NOT commit a .env file containing real secrets to version control.
# For production, inject variables via CI/CD secrets or a secrets manager.
# ==============================================================================

# ── Database ───────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=causalops
POSTGRES_USER=causalops
# REQUIRED: Set a strong password. Do not use the default in production.
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION

# ── CausalOps Backend API ──────────────────────────────────────────────────────
CAUSALOPS_API_PORT=8080
# CORS: Explicit allowed origins (comma-separated). Do NOT use * in production.
CAUSALOPS_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# JWT secret for authentication tokens. Generate with: openssl rand -hex 32
CAUSALOPS_JWT_SECRET=CHANGE_ME_IN_PRODUCTION_USE_32_BYTE_HEX
# Token expiry in seconds (default 1 hour)
CAUSALOPS_JWT_EXPIRY_SECONDS=3600
# Admin initial credentials (bootstrap only; rotate immediately after first login)
CAUSALOPS_ADMIN_USER=admin
CAUSALOPS_ADMIN_PASSWORD=CHANGE_ME_IN_PRODUCTION

# ── AI Engine ─────────────────────────────────────────────────────────────────
AI_ENGINE_URL=http://localhost:8000
AI_ENGINE_PORT=8000
# Rate limits for expensive compute endpoints (requests per minute)
AI_ENGINE_SIMULATION_RATE_LIMIT=10
AI_ENGINE_PREDICTION_RATE_LIMIT=30
# Simulation timeout in seconds
AI_ENGINE_SIMULATION_TIMEOUT_SECONDS=60

# ── Microservices (monitored application tier) ────────────────────────────────
API_GATEWAY_URL=http://localhost:8081
ORDER_SERVICE_URL=http://localhost:8082
INVENTORY_SERVICE_URL=http://localhost:8083
PAYMENT_SERVICE_URL=http://localhost:8084

# ── Observability stack ───────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
PROMETHEUS_PORT=9090
LOKI_PORT=3100
TEMPO_PORT=3200
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_IN_PRODUCTION

# ── Reference system (bundled demo target) ────────────────────────────────────
# Shared secret for the services' /internal/chaos endpoints. Leave empty to disable fault injection.
CHAOS_TOKEN=CHANGE_ME_IN_PRODUCTION
TOXIPROXY_URL=http://toxiproxy:8474
# Continuous business traffic: mean req/s, relative wave amplitude, wave period.
LOADGEN_RPS=5
LOADGEN_VARIATION=0.3
LOADGEN_PERIOD_S=600

# ── Frontend (Vite build) ──────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8080/api
VITE_AI_ENGINE_URL=http://localhost:8000

# ── Operational ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Remediation (Phase 4) ─────────────────────────────────────────────────────
# Shared secret between causalops-api and the AI engine's executor endpoints (min 16 chars).
ENGINE_INTERNAL_TOKEN=CHANGE_ME_IN_PRODUCTION_32_CHARS_MIN
# Compose project whose containers the bootstrap environment may restart/resize. Empty disables it.
CAUSALOPS_DOCKER_PROJECT=causalops
# Stops every remediation in every environment while true.
CAUSALOPS_REMEDIATION_KILL_SWITCH=false
# HMAC secret for the webhook (runbook) executor; the receiver verifies X-CausalOps-Signature.
CAUSALOPS_WEBHOOK_SECRET=

# ── ULPF: log pipeline (SIH 26156) ────────────────────────────────────────────
# Docker Hub namespace and version of the published images (docker compose pull / build_and_tag.sh).
DOCKERHUB_NAMESPACE=causalops
CAUSALOPS_VERSION=1.0.0
# DPDP pseudonymisation key: tokens and the encrypted token map depend on it. Keep it secret and stable.
ULPF_PRIVACY_KEY=CHANGE_ME_IN_PRODUCTION
# Data lake (MinIO, S3 API). The exporter writes Parquet to bucket ulpf-lake.
MINIO_ROOT_USER=causalops
MINIO_ROOT_PASSWORD=CHANGE_ME_IN_PRODUCTION
# Syslog intake ports on the host (UDP/TCP 5514, TLS 6514) and the HTTP intake/API port.
ULPF_SYSLOG_UDP_PORT=5514
ULPF_SYSLOG_TCP_PORT=5514
ULPF_SYSLOG_TLS_PORT=6514
ULPF_HTTP_PORT=8090
# Demo traffic rate (events/s) of the log replayer.
ULPF_REPLAY_RATE=40
# Optional SOAR/firewall runbook endpoint for approved "block source" actions (sent through the webhook executor).
ULPF_SOAR_WEBHOOK=
